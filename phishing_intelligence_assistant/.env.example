# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Threat intelligence (needed from Phase 7)
ENABLE_PHISHTANK=True
PHISHTANK_APP_KEY=
PHISHTANK_USER_AGENT=phishtank/your-username
ENABLE_URLHAUS=True
URLHAUS_AUTH_KEY=

# Optional enrichment (Phases 12 and 13)
ENABLE_DNS_RDAP=False
ENABLE_REDIRECT_CHECK=False

# Limits
EXTERNAL_TIMEOUT_SECONDS=5
MAX_URL_LENGTH=2048
LOOKUP_CACHE_TTL_SECONDS=3600
